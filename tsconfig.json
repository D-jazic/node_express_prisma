{
  "compilerOptions": {
    "module": "es2022",          // ← Enables import/export
    "moduleResolution": "Bundler", // ← To avoid .js/.ts suffix errors
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true               // Optional: since you're not building JS
  },
  "include": ["src"]
}
